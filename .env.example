# Telegram bot secret. Create the bot in @BotFather and never commit the real token.
BOT_TOKEN=
BOT_USERNAME=mafia_game_master_bot

# PostgreSQL database used as the source of truth for game state.
DATABASE_URL=postgresql://mafia:mafia@localhost:5432/mafia_bot?schema=public

# DEBUG is useful during development. Production should usually use info or warn.
LOG_LEVEL=debug

# Group game limits and phase durations, in seconds.
# Join/UI cap. Must stay within the min/max keys of ROLE_DISTRIBUTIONS (default 6–15).
LOBBY_MAX_PLAYERS=15
# Optional JSON role table. Empty or unset uses the compiled 6–15 default.
# Keys must be a contiguous range; each row needs all 7 roles and must sum to N.
# Example one-row table: {"6":{"MAFIA":0,"DON":1,"COMMISSIONER":1,"DOCTOR":0,"PROSTITUTE":0,"MANIAC":0,"CIVILIAN":4}}
# ROLE_DISTRIBUTIONS=
ROLE_CONFIRMATION_DURATION_SECONDS=300
DAY_DURATION_SECONDS=180
VOTE_DURATION_SECONDS=90
# The city-Mafia revote discussion always lasts at least 30 seconds.
TIE_DISCUSSION_DURATION_SECONDS=30
NIGHT_DURATION_SECONDS=120

# Player-facing name for the PROSTITUTE role. Technical database value remains PROSTITUTE.
PROSTITUTE_ROLE_NAME=Шлюха

# Development-only manual game: /testgame creates eight virtual players.
# Never enable this in a production group.
TEST_GAME_ENABLED=false
